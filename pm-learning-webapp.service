[Unit]
Description=PM Learning Webapp Next.js app
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/workspace/pm-learning-webapp
Environment=PATH=/root/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=/root/.hermes/node/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
