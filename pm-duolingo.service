[Unit]
Description=PM Quest Next.js app on port 3108
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/workspace/pm-duolingo
Environment=PATH=/root/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=/root/.hermes/node/bin/npm run start -- --hostname 0.0.0.0 --port 3108
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
